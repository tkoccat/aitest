# Bu dosyayı depoya koymayın. Değerleri Dokploy > Environment bölümüne girin.

# --- Bizim belirlediğimiz gizli anahtarlar (uzun, rastgele) ---
ADMIN_KEY=degistir-uzun-rastgele-bir-deger
INTERNAL_KEY=degistir-baska-uzun-rastgele-bir-deger
# Boş bırakılırsa /call herkese açık olur. Doluysa bağlantı /call?key=... şeklinde verilir.
CALL_PAGE_KEY=degistir-demo-baglanti-anahtari

# --- LiveKit (cloud.livekit.io > proje > Settings > Keys) ---
LIVEKIT_URL=wss://PROJE-ADINIZ.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Yapay zekâ servisleri ---
OPENAI_API_KEY=
ELEVEN_API_KEY=
# ElevenLabs ses kütüphanesinden seçtiğiniz kadın sesin ID'si (Türkçe ile deneyin)
ELEVEN_VOICE_ID=

# --- İsteğe bağlı ---
AGENCY_NAME=Demo Turizm
MAX_CALL_MINUTES=8
MAX_CALLS_PER_HOUR=30
AMBIENT_VOLUME=0.35
LLM_MODEL=gpt-4.1
ELEVEN_MODEL=eleven_flash_v2_5
SEED_DEMO=1
